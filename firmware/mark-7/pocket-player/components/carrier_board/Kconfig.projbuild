menu "Harmony Mark-7 pocket player"
    config CARRIER_EXPECTED_MAC
        string "Second Feather Wi-Fi station MAC (leave blank until identified)"
        default ""
    config CARRIER_DISPLAY_ONLY
        bool "Display test pattern only (no storage, controls or Bluetooth)"
        default n
    config MARK7_WHEEL_INPUT
        bool "Experimental Photo wheel input capture"
        depends on !MARK7_ANO_INPUT
        default n
        help
            GPIO edge capture of the wheel-master protocol. Electrical fit and
            timing under Bluetooth load still require bench qualification.
    config MARK7_ANO_INPUT
        bool "Use transferred Mark-6 ANO controls"
        default y
    config MARK7_ANO_IRQ_WAKE
        bool "Wake from ANO INT wired to A2/GPIO34"
        depends on MARK7_ANO_INPUT
        default n
        help
            Enable only after adding INT to A2 and a 10k pull-up to 3V.
            Otherwise Sleep uses the Feather Reset button to restart.
    config CARRIER_CONTROLS_ACTIONS
        bool "Enable ANO player actions"
        depends on MARK7_ANO_INPUT
        default y
    config CARRIER_ANO_ROTATION
        int "Clockwise quarter-turns from raw ANO labels"
        range 0 3
        default 1
    config CARRIER_ENCODER_REVERSE
        bool "Reverse ANO encoder direction"
        default n
    config MARK7_STORAGE_TEST
        bool "Read-only SD and shared-display test (no Bluetooth)"
        default n
endmenu
